-- AutoTeleport + AutoHold E (complete)
-- Features:
--  - Scan Workspace.BahanCraft for parts "Batu" and "Batang"
--  - GUI with lists, teleport controls, AutoHold E, distance check
--  - Realtime "Proximity to Batang" slider/textbox (0 => exactly on surface)
--  - Teleport-before-hold option
-- Paste and run in executor (Arceus) after character spawn

local Players = game:GetService("Players")
local CoreGui = game:GetService("CoreGui")
local workspace = game:GetService("Workspace")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local t0 = tick()
while not player and tick() - t0 < 10 do task.wait(0.1); player = Players.LocalPlayer end
if not player then
    local pls = Players:GetPlayers()
    player = pls[1]
end

-- ===== Runtime setting (controlled by GUI) =====
local proximityToBatang = 0.25 -- default offset from surface (0 = exactly on surface)

-- ===== Helpers: scan parts =====
local function getParts()
    local parts = { Batu = {}, Batang = {} }
    local bahan = workspace:FindFirstChild("BahanCraft")
    if not bahan then return parts end

    for _, desc in ipairs(bahan:GetDescendants()) do
        if desc:IsA("BasePart") then
            if desc.Name == "Batu" then
                table.insert(parts.Batu, desc)
            elseif desc.Name == "Batang" then
                table.insert(parts.Batang, desc)
            end
        end
    end

    return parts
end

-- ===== Utility: world position for Instance =====
local function getWorldPositionFromInstance(inst)
    if not inst then return nil end
    if inst:IsA("BasePart") then return inst.Position end
    local cur = inst
    for i = 1, 6 do
        if not cur then break end
        if cur:IsA("BasePart") then return cur.Position end
        cur = cur.Parent
    end
    local mdl = inst
    while mdl and not mdl:IsA("Workspace") do
        if mdl:IsA("Model") and mdl.PrimaryPart then return mdl.PrimaryPart.Position end
        mdl = mdl.Parent
    end
    return nil
end

-- ===== Teleport util: accurate surface placement (uses proximityToBatang) =====
local function safeTeleportTo(part)
    if not part or not part:IsA("BasePart") then return false, "Invalid target" end
    local char = player and player.Character
    if not char then return false, "Character not found" end
    local hrp = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
    if not hrp then return false, "Humanoid root not found" end

    -- determine directions to try (prioritize toward player for Batang)
    local playerPos = hrp.Position
    local toward = Vector3.new(playerPos.X - part.Position.X, 0, playerPos.Z - part.Position.Z)
    local directions = {}
    if part.Name == "Batang" and toward.Magnitude > 0.01 then
        table.insert(directions, toward.Unit)
        table.insert(directions, part.CFrame.RightVector)
        table.insert(directions, -part.CFrame.RightVector)
        table.insert(directions, part.CFrame.LookVector)
        table.insert(directions, -part.CFrame.LookVector)
    else
        directions = {
            part.CFrame.RightVector,
            -part.CFrame.RightVector,
            part.CFrame.LookVector,
            -part.CFrame.LookVector,
        }
    end

    -- supportDistanceInDirection: OBB support function in part-local space
    local function supportDistanceInDirection(dirUnit)
        local localDir = part.CFrame:VectorToObjectSpace(dirUnit)
        local he = part.Size * 0.5
        local support = math.abs(localDir.X) * he.X + math.abs(localDir.Y) * he.Y + math.abs(localDir.Z) * he.Z
        return support
    end

    local extraOffset = tonumber(proximityToBatang) or 0
    extraOffset = math.max(-1, extraOffset)

    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Blacklist
    rayParams.FilterDescendantsInstances = { char, part }

    local tryHeightAbove = 50
    local down = -Vector3.new(0, 200, 0)

    for _, dir in ipairs(directions) do
        if dir and dir.Magnitude > 0 then
            local dirUnit = dir.Unit
            local support = supportDistanceInDirection(dirUnit)
            local desiredDistance = math.max(0.01, support + extraOffset)
            local candidateXZ = part.Position + dirUnit * desiredDistance
            local origin = candidateXZ + Vector3.new(0, tryHeightAbove, 0)
            local result = workspace:Raycast(origin, down, rayParams)
            if result and result.Position then
                local groundY = result.Position.Y
                -- vertical placement offset so character stands on ground; keep small vertical padding to avoid clipping
                local targetPos = Vector3.new(candidateXZ.X, groundY + 2.2, candidateXZ.Z)
                local lookAt = Vector3.new(part.Position.X, targetPos.Y, part.Position.Z)
                local targetCFrame = CFrame.new(targetPos, lookAt)
                local ok, err = pcall(function() hrp.CFrame = targetCFrame end)
                if ok then
                    return true, "Teleported exactly beside part (raycast)"
                end
            end
        end
    end

    -- fallback: place relative to first direction without raycast
    do
        local dir = directions[1] or part.CFrame.RightVector
        local dirUnit = dir.Unit
        local support = supportDistanceInDirection(dirUnit)
        local desiredDistance = math.max(0.01, support + (tonumber(proximityToBatang) or 0))
        local candidatePos = part.Position + dirUnit * desiredDistance
        candidatePos = Vector3.new(candidatePos.X, part.Position.Y + 2.2, candidatePos.Z)
        local lookAt = Vector3.new(part.Position.X, candidatePos.Y, part.Position.Z)
        local targetCFrame = CFrame.new(candidatePos, lookAt)
        local ok, err = pcall(function() hrp.CFrame = targetCFrame end)
        if ok then
            return true, "Teleported beside part (fallback)"
        else
            return false, tostring(err)
        end
    end
end

-- ===== AutoHold utilities =====
local function triggerPromptsOnPart(part, holdDuration, distanceEnabled, maxDist, teleportBeforeHold, waitAfterTeleport)
    if not part then return false, "no part" end
    local prompts = {}
    for _,desc in ipairs(part:GetDescendants()) do
        if desc:IsA("ProximityPrompt") then table.insert(prompts, desc) end
    end
    if #prompts == 0 then return false, "no prompts" end

    local char = player and player.Character
    local hrp = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso"))

    if distanceEnabled and hrp then
        local pos = getWorldPositionFromInstance(part) or part.Position
        local dist = (hrp.Position - pos).Magnitude
        if dist > maxDist then
            if teleportBeforeHold then
                local ok, msg = safeTeleportTo(part)
                if not ok then return false, "teleport_failed" end
                task.wait(waitAfterTeleport)
            else
                return false, "skipped_by_distance"
            end
        end
    end

    for _,prompt in ipairs(prompts) do
        local okBegin = false
        pcall(function() prompt:InputHoldBegin(); okBegin = true end)
        if okBegin then
            task.wait(holdDuration)
            pcall(function() prompt:InputHoldEnd() end)
        else
            task.wait(holdDuration)
            pcall(function() prompt:InputHoldEnd() end)
        end
    end

    return true, "triggered_prompts"
end

local function triggerPromptInstance(prompt, holdDuration, distanceEnabled, maxDist, teleportBeforeHold, waitAfterTeleport, associatedPart)
    if not prompt or not prompt:IsA("ProximityPrompt") then return false, "invalid" end
    local char = player and player.Character
    local hrp = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso"))
    if distanceEnabled and hrp then
        local pos = getWorldPositionFromInstance(prompt) or (associatedPart and associatedPart.Position)
        if pos then
            local dist = (hrp.Position - pos).Magnitude
            if dist > maxDist then
                if teleportBeforeHold and associatedPart then
                    local ok, msg = safeTeleportTo(associatedPart)
                    if not ok then return false, "teleport_failed" end
                    task.wait(waitAfterTeleport)
                else
                    return false, "skipped_by_distance"
                end
            end
        end
    end

    local okBegin = false
    pcall(function() prompt:InputHoldBegin(); okBegin = true end)
    if okBegin then
        task.wait(holdDuration)
        pcall(function() prompt:InputHoldEnd() end)
        return true, "triggered"
    else
        task.wait(holdDuration)
        pcall(function() prompt:InputHoldEnd() end)
        return false, "failed_begin"
    end
end


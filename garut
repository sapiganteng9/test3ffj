            newX = math.clamp(newX, 0, math.max(0, workspace.CurrentCamera.ViewportSize.X - window.AbsoluteSize.X))
            newY = math.clamp(newY, 0, math.max(0, workspace.CurrentCamera.ViewportSize.Y - window.AbsoluteSize.Y))
            window.Position = UDim2.new(0, newX, 0, newY)
        end
    end)

    minBtn.MouseButton1Click:Connect(function()
        if content.Visible then
            content.Visible = false
            window.Size = UDim2.new(window.Size.X.Scale, window.Size.X.Offset, 0, 36)
        else
            content.Visible = true
            window.Size = UDim2.new(0,560,0,520)
        end
    end)
    closeBtn.MouseButton1Click:Connect(function() pcall(function() screenGui:Destroy() end) end)

    -- Populate lists helper
    local partRows = { Batu = {}, Batang = {} }
    local function makeRow(parent, part)
        local row = Instance.new("Frame", parent)
        row.Size = UDim2.new(1, -12, 0, 28)
        row.BackgroundTransparency = 1

        local check = Instance.new("TextButton", row)
        check.Size = UDim2.new(0, 26, 0, 26)
        check.Position = UDim2.new(0, 0, 0, 0)
        check.Text = ""
        check.BackgroundColor3 = Color3.fromRGB(50,50,50)
        Instance.new("UICorner", check).CornerRadius = UDim.new(0,4)

        local label = Instance.new("TextLabel", row)
        label.Size = UDim2.new(1, -36, 1, 0)
        label.Position = UDim2.new(0, 36, 0, 0)
        label.Text = part.Name
        label.Font = Enum.Font.SourceSans
        label.TextSize = 14
        label.TextColor3 = Color3.fromRGB(230,230,230)
        label.BackgroundTransparency = 1
        label.TextXAlignment = Enum.TextXAlignment.Left

        local selected = false
        local function updateAppearance()
            if selected then check.BackgroundColor3 = Color3.fromRGB(80,200,120) else check.BackgroundColor3 = Color3.fromRGB(50,50,50) end
        end

        check.MouseButton1Click:Connect(function()
            selected = not selected; updateAppearance()
        end)
        label.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then selected = not selected; updateAppearance() end
        end)

        return {
            Part = part,
            Row = row,
            IsSelected = function() return selected end,
            SetSelected = function(v) selected = v; updateAppearance() end,
        }
    end

    local function populate()
        for _,v in ipairs(batuScroll:GetChildren()) do if v:IsA("Frame") then v:Destroy() end end
        for _,v in ipairs(batangScroll:GetChildren()) do if v:IsA("Frame") then v:Destroy() end end
        partRows = { Batu = {}, Batang = {} }
        local parts = getParts()
        local function distSort(a,b)
            local ca = 0; local cb = 0
            if player and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                local hrp = player.Character.HumanoidRootPart
                ca = (a.Position - hrp.Position).Magnitude
                cb = (b.Position - hrp.Position).Magnitude
            else
                ca = a.Position.Magnitude; cb = b.Position.Magnitude
            end
            return ca < cb
        end
        pcall(function() table.sort(parts.Batu, distSort); table.sort(parts.Batang, distSort) end)

        for _,p in ipairs(parts.Batu) do
            local r = makeRow(batuScroll, p)
            r.Row.Parent = batuScroll
            table.insert(partRows.Batu, r)
        end
        for _,p in ipairs(parts.Batang) do
            local r = makeRow(batangScroll, p)
            r.Row.Parent = batangScroll
            table.insert(partRows.Batang, r)
        end
    end

    populate()

    selectAllBatu.MouseButton1Click:Connect(function()
        local anyUnselected = false
        for _,r in ipairs(partRows.Batu) do if not r.IsSelected() then anyUnselected = true; break end end
        for _,r in ipairs(partRows.Batu) do r.SetSelected(anyUnselected) end
    end)
    selectAllBatang.MouseButton1Click:Connect(function()
        local anyUnselected = false
        for _,r in ipairs(partRows.Batang) do if not r.IsSelected() then anyUnselected = true; break end end
        for _,r in ipairs(partRows.Batang) do r.SetSelected(anyUnselected) end
    end)

    title.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton2 then
            populate()
            statusLabel.Text = "Status: Refreshed daftar parts"
        end
    end)

    -- Slider behavior
    local function setSliderValue(val)
        val = tonumber(val) or proximityToBatang
        val = math.clamp(val, proxMin, proxMax)
        proximityToBatang = val
        proxBox.Text = string.format("%.2f", val)
        local percent = (val - proxMin) / (proxMax - proxMin)
        sliderFill.Size = UDim2.new(math.clamp(percent,0,1), 0, 1, 0)
        sliderKnob.Position = UDim2.new(math.clamp(percent,0,1), -9, 0.5, -9)
    end

    setSliderValue(proximityToBatang)

    local draggingSlider = false
    sliderKnob.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            draggingSlider = true
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then draggingSlider = false end
            end)
        end
    end)
    sliderBar.InputChanged:Connect(function(input)
        if draggingSlider and input.UserInputType == Enum.UserInputType.MouseMovement then
            local absX = input.Position.X
            local left = sliderBar.AbsolutePosition.X
            local width = sliderBar.AbsoluteSize.X
            local rel = (absX - left) / width
            local val = proxMin + (proxMax - proxMin) * rel
            setSliderValue(val)
        end
    end)
    sliderBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            local absX = input.Position.X
            local left = sliderBar.AbsolutePosition.X
            local width = sliderBar.AbsoluteSize.X
            local rel = (absX - left) / width
            local val = proxMin + (proxMax - proxMin) * rel
            setSliderValue(val)
        end
    end)

    proxBox.FocusLost:Connect(function()
        local v = tonumber(proxBox.Text)
        if v then setSliderValue(v) else setSliderValue(proximityToBatang) end
    end)

    -- Teleport / start stop logic
    local running = false
    local function getSelectedParts()
        local list = {}
        for _,r in ipairs(partRows.Batu) do if r.IsSelected() and r.Part and r.Part.Parent then table.insert(list, r.Part) end end
        for _,r in ipairs(partRows.Batang) do if r.IsSelected() and r.Part and r.Part.Parent then table.insert(list, r.Part) end end
        return list
    end

    local function waitWithCountdown(seconds, statusPrefix)
        local start = tick()
        while tick() - start < seconds do
            local remaining = math.max(0, seconds - (tick() - start))
            statusLabel.Text = string.format("%s - Next in: %.1f s", statusPrefix, remaining)
            task.wait(0.1)
            if not running then break end
        end
    end

    startBtn.MouseButton1Click:Connect(function()
        if running then return end
        local d = tonumber(delayBox.Text) or 15
        d = math.clamp(d, 1, 300)
        local selected = getSelectedParts()
        if #selected == 0 then statusLabel.Text = "Status: Tidak ada part terpilih!"; return end

        running = true
        statusLabel.Text = "Status: Mulai teleport..."
        task.spawn(function()
            while running do
                local targets = getSelectedParts()
                if #targets == 0 then statusLabel.Text = "Status: Tidak ada target terpilih, berhenti."; running = false; break end
                for i, part in ipairs(targets) do
                    if not running then break end
                    if part and part.Parent then
                        statusLabel.Text = string.format("Status: Teleport ke '%s' (%d/%d)", part.Name, i, #targets)
                        local ok, msg = safeTeleportTo(part)
                        if not ok then statusLabel.Text = "Error teleport: " .. tostring(msg) end
                        waitWithCountdown(d, "Status: Teleport berjalan")
                    else
                        statusLabel.Text = "Status: Target tidak ditemukan, melewatkan..."
                        task.wait(0.5)
                    end
                end
            end
            statusLabel.Text = "Status: Stopped"
        end)
    end)

    stopBtn.MouseButton1Click:Connect(function()
        if running then running = false; statusLabel.Text = "Status: Menghentikan..." end
    end)

    -- AutoHold loop
    local autoHoldRunning = false

    autoHoldToggle.MouseButton1Click:Connect(function()
        autoHoldRunning = not autoHoldRunning
        if autoHoldRunning then
            autoHoldToggle.Text = "AutoHold: ON"; autoHoldToggle.BackgroundColor3 = Color3.fromRGB(80,200,120); autoHoldToggle.TextColor3 = Color3.fromRGB(20,20,20)
            task.spawn(function()
                while autoHoldRunning do
                    local holdDur = math.clamp(tonumber(holdBox.Text) or 1, 0.05, 60)
                    local interval = math.clamp(tonumber(intervalBox.Text) or 1, 0.05, 600)
                    local distanceEnabled = true
                    local maxDist = math.clamp(tonumber(distanceBox.Text) or 13, 0.5, 1000)
                    local teleportBeforeHoldEnabled = (teleportToggle.Text:find("ON") ~= nil)
                    local waitAfterTeleport = math.clamp(tonumber(waitAfterTeleportBox.Text) or 0.6, 0.01, 5)

                    local targets = getSelectedParts()
                    if #targets == 0 then
                        local bahan = workspace:FindFirstChild("BahanCraft")
                        if bahan then
                            for _,desc in ipairs(bahan:GetDescendants()) do
                                if not autoHoldRunning then break end
                                if desc:IsA("ProximityPrompt") then
                                    local ok, msg = triggerPromptInstance(desc, holdDur, distanceEnabled, maxDist, teleportBeforeHoldEnabled, waitAfterTeleport, nil)
                                    if ok then statusLabel.Text = "AutoHold: triggered prompt" end
                                    if msg == "skipped_by_distance" then statusLabel.Text = "AutoHold: skipped prompt (too far)" end
                                end
                                task.wait(0.05)
                            end
                        end
                    else
                        for _,part in ipairs(targets) do
                            if not autoHoldRunning then break end
                            local ok, msg = triggerPromptsOnPart(part, holdDur, distanceEnabled, maxDist, teleportBeforeHoldEnabled, waitAfterTeleport)
                            if ok then
                                statusLabel.Text = string.format("AutoHold: triggered prompts on %s", part.Name)
                            else
                                if msg == "skipped_by_distance" then
                                    statusLabel.Text = string.format("AutoHold: skipped %s (too far)", part.Name)
                                elseif msg == "teleport_failed" then
                                    statusLabel.Text = string.format("AutoHold: teleport failed for %s", part.Name)
                                else
                                    statusLabel.Text = string.format("AutoHold: %s (%s)", tostring(msg), part.Name)
                                end
                            end
                            task.wait(0.12)
                        end
                    end

                    local elapsed = 0
                    while elapsed < interval and autoHoldRunning do
                        task.wait(0.1); elapsed = elapsed + 0.1
                    end
                end
                statusLabel.Text = "Status: AutoHold stopped"
            end)
        else
            autoHoldToggle.Text = "AutoHold: OFF"; autoHoldToggle.BackgroundColor3 = Color3.fromRGB(150,150,150); autoHoldToggle.TextColor3 = Color3.fromRGB(255,255,255)
        end
    end)

    -- toggles and validation
    distanceBox.FocusLost:Connect(function()
        distanceBox.Text = tostring(math.clamp(tonumber(distanceBox.Text) or 13, 0.5, 1000))
    end)
    teleportToggle.MouseButton1Click:Connect(function()
        if teleportToggle.Text:find("OFF") then
            teleportToggle.Text = "Teleport-before-hold: ON"; teleportToggle.BackgroundColor3 = Color3.fromRGB(80,200,120); teleportToggle.TextColor3 = Color3.fromRGB(20,20,20)
        else
            teleportToggle.Text = "Teleport-before-hold: OFF"; teleportToggle.BackgroundColor3 = Color3.fromRGB(150,150,150); teleportToggle.TextColor3 = Color3.fromRGB(255,255,255)
        end
    end)
    waitAfterTeleportBox.FocusLost:Connect(function() waitAfterTeleportBox.Text = tostring(math.clamp(tonumber(waitAfterTeleportBox.Text) or 0.6, 0.01, 5)) end)

    -- Refresh on descendant change
    local bahan = workspace:FindFirstChild("BahanCraft")
    if bahan then
        bahan.DescendantAdded:Connect(function() task.wait(0.25); populate() end)
        bahan.DescendantRemoving:Connect(function() task.wait(0.25); populate() end)
    end

    statusLabel.Text = "Status: Idle - Atur Proximity to Batang dengan slider/textbox (realtime). Right-click title untuk refresh list."
    return screenGui
end

local ok, res = pcall(createGui)
if not ok then warn("Failed creating GUI:", res) end

local function findPartPosition(part)
    if part and part.Parent then
        local partPosition = part.Position
        local partSize = part.Size
        
        -- Hitung Y paling bawah dari part
        local bottomY = partPosition.Y - (partSize.Y / 2)
        
        -- Teleport posisi: di atas tanah dengan jarak aman 3 studs
        local positionAboveGround = Vector3.new(
            partPosition.X,
            bottomY + 3,  -- Jarak 3 studs di atas tanah
            partPosition.Z
        )
        
        return positionAboveGround
    end
    return nil
end

local function teleportCharacterToPosition(targetPosition)
    if not character or not humanoidRootPart or not humanoidRootPart.Parent then return false end
    
    local success = pcall(function()
        -- Disable collision sementara saat teleport
        local oldNoclip = Config.noclipEnabled
        
        for _, part in pairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                pcall(function()
                    part.CanCollide = false
                end)
            end
        end
        
        -- Teleport langsung
        humanoidRootPart.CFrame = CFrame.new(targetPosition)
        
        wait(0.2)
        
        -- Restore collision jika noclip off
        if not oldNoclip then
            for _, part in pairs(character:GetDescendants()) do
                if part:IsA("BasePart") then
                    pcall(function()
                        part.CanCollide = true
                    end)
                end
            end
        end
    end)
    
    return success
end

local function applyNoclip()
    if character then
        for _, part in pairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                pcall(function()
                    part.CanCollide = false
                end)
            end
        end
    end
end

local function removeNoclip()
    if character then
        for _, part in pairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                pcall(function()
                    part.CanCollide = true
                end)
            end
        end
    end
end

local function holdKeyDown(keyCode)
    local UIS = UserInputService
    pcall(function()
        UIS:SendKeyEvent(true, keyCode, false, game)
    end)
end

local function releaseKey(keyCode)
    local UIS = UserInputService
    pcall(function()
        UIS:SendKeyEvent(false, keyCode, false, game)
    end)
end


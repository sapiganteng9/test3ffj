    selectAllBatu.TextColor3 = Color3.fromRGB(255,255,255); Instance.new("UICorner", selectAllBatu).CornerRadius = UDim.new(0,6)

    local selectAllBatang = Instance.new("TextButton", rightPane)
    selectAllBatang.Text = "Pilih Semua"; selectAllBatang.Font = Enum.Font.SourceSans; selectAllBatang.TextSize = 13
    selectAllBatang.Size = UDim2.new(0,100,0,26); selectAllBatang.Position = UDim2.new(1,-108,0,8); selectAllBatang.BackgroundColor3 = Color3.fromRGB(90,140,255)
    selectAllBatang.TextColor3 = Color3.fromRGB(255,255,255); Instance.new("UICorner", selectAllBatang).CornerRadius = UDim.new(0,6)

    local startBtn = Instance.new("TextButton", controlsFrame)
    startBtn.Text = "Start"; startBtn.Font = Enum.Font.SourceSansBold; startBtn.TextSize = 16
    startBtn.Size = UDim2.new(0.48,-6,0,36); startBtn.Position = UDim2.new(0,0,0,42); startBtn.BackgroundColor3 = Color3.fromRGB(80,200,120)
    startBtn.TextColor3 = Color3.fromRGB(20,20,20); Instance.new("UICorner", startBtn).CornerRadius = UDim.new(0,6)

    local stopBtn = Instance.new("TextButton", controlsFrame)
    stopBtn.Text = "Stop"; stopBtn.Font = Enum.Font.SourceSansBold; stopBtn.TextSize = 16
    stopBtn.Size = UDim2.new(0.48,-6,0,36); stopBtn.Position = UDim2.new(0.52,6,0,42); stopBtn.BackgroundColor3 = Color3.fromRGB(220,80,80)
    stopBtn.TextColor3 = Color3.fromRGB(255,255,255); Instance.new("UICorner", stopBtn).CornerRadius = UDim.new(0,6)

    local statusLabel = Instance.new("TextLabel", controlsFrame)
    statusLabel.Text = "Status: Idle"; statusLabel.Font = Enum.Font.SourceSans; statusLabel.TextSize = 14
    statusLabel.TextColor3 = Color3.fromRGB(220,220,220); statusLabel.BackgroundTransparency = 1
    statusLabel.Size = UDim2.new(1,0,0,26); statusLabel.Position = UDim2.new(0,0,0,90); statusLabel.TextXAlignment = Enum.TextXAlignment.Left

    -- make row helper
    local function makeRow(parent, part)
        local row = Instance.new("Frame", parent)
        row.Size = UDim2.new(1,-12,0,28); row.BackgroundTransparency = 1

        local check = Instance.new("TextButton", row)
        check.Size = UDim2.new(0,26,0,26); check.Position = UDim2.new(0,0,0,0); check.Text = ""
        check.BackgroundColor3 = Color3.fromRGB(50,50,50); Instance.new("UICorner", check).CornerRadius = UDim.new(0,4)

        local label = Instance.new("TextLabel", row)
        label.Size = UDim2.new(1,-36,1,0); label.Position = UDim2.new(0,36,0,0)
        label.Text = part.Name; label.Font = Enum.Font.SourceSans; label.TextSize = 14
        label.TextColor3 = Color3.fromRGB(230,230,230); label.BackgroundTransparency = 1; label.TextXAlignment = Enum.TextXAlignment.Left

        local selected = false
        local function updateAppearance()
            if selected then check.BackgroundColor3 = Color3.fromRGB(80,200,120) else check.BackgroundColor3 = Color3.fromRGB(50,50,50) end
        end

        check.MouseButton1Click:Connect(function() selected = not selected; updateAppearance() end)
        label.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 then selected = not selected; updateAppearance() end end)

        return {
            Part = part,
            Row = row,
            IsSelected = function() return selected end,
            SetSelected = function(v) selected = v; updateAppearance() end,
        }
    end

    local partRows = { Batu = {}, Batang = {} }

    local function populate()
        for _,v in ipairs(batuScroll:GetChildren()) do if v:IsA("Frame") then v:Destroy() end end
        for _,v in ipairs(batangScroll:GetChildren()) do if v:IsA("Frame") then v:Destroy() end end
        partRows = { Batu = {}, Batang = {} }

        local parts = getParts()
        -- optional sort: by distance to player for nicer order
        local function distSort(a,b)
            local pa, pb = a.Position, b.Position
            local ca = player and player.Character and (player.Character:FindFirstChild("HumanoidRootPart") and (pa - player.Character.HumanoidRootPart.Position).Magnitude) or pa.Magnitude
            local cb = player and player.Character and (player.Character:FindFirstChild("HumanoidRootPart") and (pb - player.Character.HumanoidRootPart.Position).Magnitude) or pb.Magnitude
            return ca < cb
        end
        pcall(function() table.sort(parts.Batu, distSort); table.sort(parts.Batang, distSort) end)

        for _,p in ipairs(parts.Batu) do table.insert(partRows.Batu, makeRow(batuScroll, p)) end
        for _,p in ipairs(parts.Batang) do table.insert(partRows.Batang, makeRow(batangScroll, p)) end
    end

    populate()

    selectAllBatu.MouseButton1Click:Connect(function()
        local anyUnselected = false
        for _,r in ipairs(partRows.Batu) do if not r.IsSelected() then anyUnselected = true; break end end
        for _,r in ipairs(partRows.Batu) do r.SetSelected(anyUnselected) end
    end)

    selectAllBatang.MouseButton1Click:Connect(function()
        local anyUnselected = false
        for _,r in ipairs(partRows.Batang) do if not r.IsSelected() then anyUnselected = true; break end end
        for _,r in ipairs(partRows.Batang) do r.SetSelected(anyUnselected) end
    end)

    title.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton2 then
            populate()
            statusLabel.Text = "Status: Refreshed daftar parts"
        end
    end)

    -- drag window
    local dragging, dragStart, startPos = false, nil, nil
    titleBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true; dragStart = input.Position; startPos = window.Position
            input.Changed:Connect(function() if input.UserInputState == Enum.UserInputState.End then dragging = false end end)
        end
    end)
    titleBar.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            local newX = startPos.X.Offset + delta.X
            local newY = startPos.Y.Offset + delta.Y
            newX = math.clamp(newX, 0, math.max(0, workspace.CurrentCamera.ViewportSize.X - window.AbsoluteSize.X))
            newY = math.clamp(newY, 0, math.max(0, workspace.CurrentCamera.ViewportSize.Y - window.AbsoluteSize.Y))
            window.Position = UDim2.new(0, newX, 0, newY)
        end
    end)

    local minimized = false
    minBtn.MouseButton1Click:Connect(function()
        minimized = not minimized
        if minimized then content.Visible = false; window.Size = UDim2.new(window.Size.X.Scale, window.Size.X.Offset, 0, 34)
        else content.Visible = true; window.Size = UDim2.new(0,420,0,380) end
    end)

    closeBtn.MouseButton1Click:Connect(function() pcall(function() screenGui:Destroy() end) end)

    -- teleport loop
    local running = false
    local function getSelectedParts()
        local list = {}
        for _,r in ipairs(partRows.Batu) do if r.IsSelected() and r.Part and r.Part.Parent then table.insert(list, r.Part) end end
        for _,r in ipairs(partRows.Batang) do if r.IsSelected() and r.Part and r.Part.Parent then table.insert(list, r.Part) end end
        return list
    end

    local function waitWithCountdown(seconds, statusPrefix)
        local start = tick()
        while tick() - start < seconds do
            local remaining = math.max(0, seconds - (tick() - start))
            statusLabel.Text = string.format("%s - Next in: %.1f s", statusPrefix, remaining)
            task.wait(0.1)
            if not running then break end
        end
    end

    startBtn.MouseButton1Click:Connect(function()
        if running then return end
        local d = tonumber(delayBox.Text) or 15
        d = math.clamp(d, 1, 300)
        local selected = getSelectedParts()
        if #selected == 0 then statusLabel.Text = "Status: Tidak ada part terpilih!"; return end

        running = true
        statusLabel.Text = "Status: Mulai teleport..."
        task.spawn(function()
            while running do
                local targets = getSelectedParts()
                if #targets == 0 then statusLabel.Text = "Status: Tidak ada target terpilih, berhenti."; running = false; break end
                for i, part in ipairs(targets) do
                    if not running then break end
                    if part and part.Parent then
                        statusLabel.Text = string.format("Status: Teleport ke '%s' (%d/%d)", part.Name, i, #targets)
                        local ok, msg = safeTeleportTo(part)
                        if not ok then statusLabel.Text = "Error teleport: " .. tostring(msg) end
                        waitWithCountdown(d, "Status: Teleport berjalan")
                    else
                        statusLabel.Text = "Status: Target tidak ditemukan, melewatkan..."
                        task.wait(0.5)
                    end
                end
                -- terus loop sampai Stop ditekan
            end
            statusLabel.Text = "Status: Stopped"
        end)
    end)

    stopBtn.MouseButton1Click:Connect(function()
        if running then running = false; statusLabel.Text = "Status: Menghentikan..." end
    end)

    -- auto-refresh on changes
    local bahan = workspace:FindFirstChild("BahanCraft")
    if bahan then
        bahan.DescendantAdded:Connect(function() task.wait(0.25); populate() end)
        bahan.DescendantRemoving:Connect(function() task.wait(0.25); populate() end)
    end

    statusLabel.Text = "Status: Idle - Klik item untuk memilih. Right-click title untuk refresh."
    return screenGui
end

-- create GUI
local ok, res = pcall(createGui)
if not ok then warn("Failed creating GUI:", res) end

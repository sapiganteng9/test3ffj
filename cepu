-- AutoTeleport Executor (improved)
-- Scan semua "Batu" & "Batang" di Workspace.BahanCraft
-- Teleport ke samping part: coba 4 arah + raycast untuk menemukan ground yang aman
-- GUI ditempel ke CoreGui (fallback PlayerGui). Proteksi GUI bila tersedia (syn.protect_gui, gethui, dll.)

local Players = game:GetService("Players")
local CoreGui = game:GetService("CoreGui")
local workspace = game:GetService("Workspace")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local t0 = tick()
while not player and tick() - t0 < 10 do task.wait(0.1); player = Players.LocalPlayer end
if not player then
    local pls = Players:GetPlayers()
    player = pls[1]
end

-- =========================
-- Helper: scan parts
-- =========================
local function getParts()
    local parts = { Batu = {}, Batang = {} }
    local bahan = workspace:FindFirstChild("BahanCraft")
    if not bahan then return parts end

    for _, desc in ipairs(bahan:GetDescendants()) do
        if desc:IsA("BasePart") then
            if desc.Name == "Batu" then
                table.insert(parts.Batu, desc)
            elseif desc.Name == "Batang" then
                table.insert(parts.Batang, desc)
            end
        end
    end

    return parts
end

-- =========================
-- Teleport util: try 4 directions + raycast down
-- =========================
local function safeTeleportTo(part)
    if not part or not part:IsA("BasePart") then return false, "Invalid target" end
    local char = player and player.Character
    if not char then return false, "Character not found" end
    local hrp = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
    if not hrp then return false, "Humanoid root not found" end

    -- parameters
    local sizeX, sizeZ = part.Size.X, part.Size.Z
    local horizHalf = math.max(sizeX, sizeZ) / 2
    local sideExtra = 3 -- jarak ekstra dari sisi part
    local tryHeightAbove = 50
    local raycastDown = -Vector3.new(0, 200, 0)

    -- directions: Right, Left, Forward, Back (relative ke orientasi part)
    local directions = {
        part.CFrame.RightVector,
        -part.CFrame.RightVector,
        part.CFrame.LookVector,
        -part.CFrame.LookVector,
    }

    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Blacklist
    -- ignore character and the target part to detect ground around it
    rayParams.FilterDescendantsInstances = { char, part }

    -- Try each direction: raycast from above candidate position, downwards
    for _, dir in ipairs(directions) do
        local candidateXZ = part.Position + dir * (horizHalf + sideExtra)
        local origin = candidateXZ + Vector3.new(0, tryHeightAbove, 0)
        local result = workspace:Raycast(origin, raycastDown, rayParams)
        if result and result.Position then
            -- found ground; set Y slightly above hit point
            local groundY = result.Position.Y
            local targetPos = Vector3.new(candidateXZ.X, groundY + 2.2, candidateXZ.Z) -- sedikit offset agar tidak nge-clip
            local lookAt = Vector3.new(part.Position.X, targetPos.Y, part.Position.Z)
            local targetCFrame = CFrame.new(targetPos, lookAt)
            local ok, err = pcall(function() hrp.CFrame = targetCFrame end)
            if ok then
                return true, "Teleported beside part (raycast)"
            end
            -- else try next direction
        end
    end

    -- fallback: posisi samping relatif ke RightVector tanpa raycast
    do
        local dir = part.CFrame.RightVector
        local candidatePos = part.Position + dir * (horizHalf + sideExtra)
        candidatePos = Vector3.new(candidatePos.X, part.Position.Y + 2.5, candidatePos.Z)
        local lookAt = Vector3.new(part.Position.X, candidatePos.Y, part.Position.Z)
        local targetCFrame = CFrame.new(candidatePos, lookAt)
        local ok, err = pcall(function() hrp.CFrame = targetCFrame end)
        if ok then
            return true, "Teleported beside part (fallback)"
        else
            return false, tostring(err)
        end
    end
end


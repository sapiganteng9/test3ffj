-- Teleport logic
local running = false
local teleportCoroutine = nil

local function getSelectedParts()
	local list = {}
	for _,r in ipairs(partRows.Batu) do
		if r.IsSelected() and r.Part and r.Part.Parent then
			table.insert(list, r.Part)
		end
	end
	for _,r in ipairs(partRows.Batang) do
		if r.IsSelected() and r.Part and r.Part.Parent then
			table.insert(list, r.Part)
		end
	end
	return list
end

local function safeTeleportTo(part)
	local char = player.Character
	if not char then return false, "Character not found" end
	local hrp = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
	if not hrp then return false, "Humanoid root not found" end
	if not part or not part:IsA("BasePart") then return false, "Target invalid" end
	-- Compute offset: place player slightly above part
	local topY = part.Position.Y + (part.Size.Y/2) + 3
	local targetCFrame = CFrame.new(part.Position.X, topY, part.Position.Z) * CFrame.Angles(0, 0, 0)
	-- Use pcall to avoid errors if something goes wrong
	local ok, err = pcall(function()
		hrp.CFrame = targetCFrame
	end)
	if ok then
		return true, "Teleported"
	else
		return false, tostring(err)
	end
end

-- Countdown display helper
local function waitWithCountdown(seconds, statusPrefix)
	local start = tick()
	while tick() - start < seconds do
		local remaining = math.max(0, seconds - (tick() - start))
		statusLabel.Text = string.format("%s - Next in: %.1f s", statusPrefix, remaining)
		wait(0.1)
		-- if running flag false, break early
		if not running then break end
	end
end

startBtn.MouseButton1Click:Connect(function()
	if running then return end
	-- parse delay
	local d = tonumber(delayBox.Text) or 15
	if d < 0.5 then d = 0.5 end
	-- clamp recommended range 1-60
	if d < 1 then d = 1 elseif d > 300 then d = 300 end

	local selected = getSelectedParts()
	if #selected == 0 then
		statusLabel.Text = "Status: Tidak ada part terpilih!"
		return
	end

	running = true
	statusLabel.Text = "Status: Mulai teleport..."
	teleportCoroutine = coroutine.create(function()
		while running do
			-- refresh selected list each loop to allow dynamic changes
			local targets = getSelectedParts()
			if #targets == 0 then
				statusLabel.Text = "Status: Tidak ada target terpilih, berhenti."
				running = false
				break
			end
			for i,part in ipairs(targets) do
				if not running then break end
				if part and part.Parent then
					statusLabel.Text = string.format("Status: Teleport ke '%s' (%d/%d)", part.Name, i, #targets)
					local ok, msg = safeTeleportTo(part)
					if not ok then
						statusLabel.Text = "Error teleport: "..msg
					end
					-- wait with countdown; exit early if stopped
					waitWithCountdown(d, "Status: Teleport berjalan")
				else
					-- skip invalid part
					statusLabel.Text = "Status: Target tidak ditemukan, melewatkan..."
					wait(0.5)
				end
			end
			-- loop terus; jika ingin berhenti setelah satu putaran, set running=false di sini
		end
		statusLabel.Text = "Status: Stopped"
	end)
	-- start coroutine
	coroutine.resume(teleportCoroutine)
end)

stopBtn.MouseButton1Click:Connect(function()

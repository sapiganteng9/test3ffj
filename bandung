-- Utility: cari parts berdasarkan struktur yang diberikan
local function getParts()
	local parts = {
		Batu = {},
		Batang = {},
	}
	local bahan = workspace:FindFirstChild("BahanCraft")
	if not bahan then return parts end

	-- Batu di BahanCraft.BatuBesar (ambil semua BasePart bernama "Batu")
	local batuBesar = bahan:FindFirstChild("BatuBesar")
	if batuBesar then
		for _,desc in ipairs(batuBesar:GetDescendants()) do
			if desc:IsA("BasePart") and desc.Name == "Batu" then
				table.insert(parts.Batu, desc)
			end
		end
	end

	-- Batang di BahanCraft.PohonBesar (ambil semua BasePart bernama "Batang")
	local pohonBesar = bahan:FindFirstChild("PohonBesar")
	if pohonBesar then
		for _,desc in ipairs(pohonBesar:GetDescendants()) do
			if desc:IsA("BasePart") and desc.Name == "Batang" then
				table.insert(parts.Batang, desc)
			end
		end
	end

	return parts
end


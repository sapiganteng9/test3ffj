        d = math.clamp(d, 1, 300)
        local selected = getSelectedParts()
        if #selected == 0 then statusLabel.Text = "Status: Tidak ada part terpilih!"; return end

        running = true
        statusLabel.Text = "Status: Mulai teleport..."
        task.spawn(function()
            while running do
                local targets = getSelectedParts()
                if #targets == 0 then statusLabel.Text = "Status: Tidak ada target terpilih, berhenti."; running = false; break end
                for i, part in ipairs(targets) do
                    if not running then break end
                    if part and part.Parent then
                        statusLabel.Text = string.format("Status: Teleport ke '%s' (%d/%d)", part.Name, i, #targets)
                        local ok, msg = safeTeleportTo(part)
                        if not ok then statusLabel.Text = "Error teleport: " .. tostring(msg) end
                        waitWithCountdown(d, "Status: Teleport berjalan")
                    else
                        statusLabel.Text = "Status: Target tidak ditemukan, melewatkan..."
                        task.wait(0.5)
                    end
                end
            end
            statusLabel.Text = "Status: Stopped"
        end)
    end)

    stopBtn.MouseButton1Click:Connect(function()
        if running then running = false; statusLabel.Text = "Status: Menghentikan..." end
    end)

    -- Auto Hold E loop with distance option
    local autoHoldRunning = false
    local function getSelectedPartsForAutoHold()
        return getSelectedParts()
    end

    autoHoldToggle.MouseButton1Click:Connect(function()
        autoHoldRunning = not autoHoldRunning
        if autoHoldRunning then
            autoHoldToggle.Text = "ON"; autoHoldToggle.BackgroundColor3 = Color3.fromRGB(80,200,120)
            task.spawn(function()
                while autoHoldRunning do
                    local holdDur = tonumber(holdBox.Text) or 1
                    holdDur = math.clamp(holdDur, 0.1, 60)
                    local interval = tonumber(intervalBox.Text) or 1
                    interval = math.clamp(interval, 0.1, 600)
                    local distanceEnabled = (distanceToggle.Text == "ON")
                    local maxDist = tonumber(distanceBox.Text) or 13
                    maxDist = math.clamp(maxDist, 0.5, 1000)

                    local targets = getSelectedPartsForAutoHold()
                    if #targets == 0 then
                        local bahan = workspace:FindFirstChild("BahanCraft")
                        if bahan then
                            for _,desc in ipairs(bahan:GetDescendants()) do
                                if not autoHoldRunning then break end
                                if desc:IsA("ProximityPrompt") then
                                    local ok, msg = triggerPromptInstance(desc, holdDur, distanceEnabled, maxDist)
                                    if ok then
                                        statusLabel.Text = string.format("AutoHold: triggered prompt at %s", tostring(getWorldPositionFromInstance(desc) and tostring(math.floor((player.Character and (player.Character:FindFirstChild("HumanoidRootPart") and (player.Character.HumanoidRootPart.Position - getWorldPositionFromInstance(desc)).Magnitude) or 0) ) ) ) )
                                    else
                                        if msg == "skipped_by_distance" then
                                            statusLabel.Text = "AutoHold: skipped prompt (too far)"
                                        else
                                            statusLabel.Text = "AutoHold: failed to trigger prompt"
                                        end
                                    end
                                end
                                task.wait(0.05)
                            end
                        end
                    else
                        for _,part in ipairs(targets) do
                            if not autoHoldRunning then break end
                            local ok, msg = triggerPromptsOnPart(part, holdDur, distanceEnabled, maxDist)
                            if ok then
                                statusLabel.Text = string.format("AutoHold: triggered prompts on %s", part.Name)
                            else
                                if msg == "skipped_by_distance" then
                                    statusLabel.Text = string.format("AutoHold: skipped %s (too far)", part.Name)
                                else
                                    statusLabel.Text = string.format("AutoHold: %s (%s)", tostring(msg), part.Name)
                                end
                            end
                            task.wait(0.1)
                        end
                    end

                    local elapsed = 0
                    while elapsed < interval and autoHoldRunning do
                        task.wait(0.1); elapsed = elapsed + 0.1
                    end
                end
                statusLabel.Text = "Status: AutoHold stopped"
            end)
        else
            autoHoldToggle.Text = "OFF"; autoHoldToggle.BackgroundColor3 = Color3.fromRGB(150,150,150)
        end
    end)

    -- distance toggle button behavior
    distanceToggle.MouseButton1Click:Connect(function()
        if distanceToggle.Text == "ON" then
            distanceToggle.Text = "OFF"; distanceToggle.BackgroundColor3 = Color3.fromRGB(150,150,150)
        else
            distanceToggle.Text = "ON"; distanceToggle.BackgroundColor3 = Color3.fromRGB(80,200,120)
        end
    end)

    local bahan = workspace:FindFirstChild("BahanCraft")
    if bahan then
        bahan.DescendantAdded:Connect(function() task.wait(0.25); populate() end)
        bahan.DescendantRemoving:Connect(function() task.wait(0.25); populate() end)
    end

    statusLabel.Text = "Status: Idle - Klik item untuk memilih. Right-click title untuk refresh."
    return screenGui
end

local ok, res = pcall(createGui)
if not ok then warn("Failed creating GUI:", res) end

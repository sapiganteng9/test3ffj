-- Helper: scan parts
local function getParts()
    local parts = { Batu = {}, Batang = {} }
    local bahan = workspace:FindFirstChild("BahanCraft")
    if not bahan then return parts end

    for _, desc in ipairs(bahan:GetDescendants()) do
        if desc:IsA("BasePart") then
            if desc.Name == "Batu" then
                table.insert(parts.Batu, desc)
            elseif desc.Name == "Batang" then
                table.insert(parts.Batang, desc)
            end
        end
    end

    return parts
end

-- Teleport util (tetap sama seperti sebelumnya)
local function safeTeleportTo(part)
    if not part or not part:IsA("BasePart") then return false, "Invalid target" end
    local char = player and player.Character
    if not char then return false, "Character not found" end
    local hrp = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
    if not hrp then return false, "Humanoid root not found" end

    local sizeX, sizeZ = part.Size.X, part.Size.Z
    local horizHalf = math.max(sizeX, sizeZ) / 2
    local sideExtra = 3
    local extraForward = 0
    if part.Name == "Batang" then extraForward = 3 end
    local function computeDist() return math.max(1, horizHalf + sideExtra - extraForward) end

    local tryHeightAbove = 50
    local raycastDown = -Vector3.new(0, 200, 0)

    local directions = {
        part.CFrame.RightVector,
        -part.CFrame.RightVector,
        part.CFrame.LookVector,
        -part.CFrame.LookVector,
    }

    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Blacklist
    rayParams.FilterDescendantsInstances = { char, part }

    for _, dir in ipairs(directions) do
        local dist = computeDist()
        local candidateXZ = part.Position + dir * dist
        local origin = candidateXZ + Vector3.new(0, tryHeightAbove, 0)
        local result = workspace:Raycast(origin, raycastDown, rayParams)
        if result and result.Position then
            local groundY = result.Position.Y
            local targetPos = Vector3.new(candidateXZ.X, groundY + 2.2, candidateXZ.Z)
            local lookAt = Vector3.new(part.Position.X, targetPos.Y, part.Position.Z)
            local targetCFrame = CFrame.new(targetPos, lookAt)
            local ok, err = pcall(function() hrp.CFrame = targetCFrame end)
            if ok then
                return true, "Teleported beside part (raycast)"
            end
        end
    end

    do
        local dist = computeDist()
        local dir = part.CFrame.RightVector
        local candidatePos = part.Position + dir * dist
        candidatePos = Vector3.new(candidatePos.X, part.Position.Y + 2.5, candidatePos.Z)
        local lookAt = Vector3.new(part.Position.X, candidatePos.Y, part.Position.Z)
        local targetCFrame = CFrame.new(candidatePos, lookAt)
        local ok, err = pcall(function() hrp.CFrame = targetCFrame end)
        if ok then
            return true, "Teleported beside part (fallback)"
        else
            return false, tostring(err)
        end
    end
end

-- Utility: get reasonable world position for an Instance (BasePart ancestor or Model.PrimaryPart)
local function getWorldPositionFromInstance(inst)
    if not inst then return nil end
    if inst:IsA("BasePart") then return inst.Position end
    -- search ancestors for BasePart
    local cur = inst
    for i = 1, 6 do -- depth safety
        if not cur then break end
        if cur:IsA("BasePart") then return cur.Position end
        cur = cur.Parent
    end
    -- if it's a Model, try PrimaryPart
    local mdl = inst
    while mdl and not mdl:IsA("Workspace") do
        if mdl:IsA("Model") and mdl.PrimaryPart then return mdl.PrimaryPart.Position end
        mdl = mdl.Parent
    end
    return nil
end

-- Auto Hold util
local function triggerPromptsOnPart(part, holdDuration, distanceEnabled, maxDist)
    if not part then return false, "no part" end
    local prompts = {}
    for _,desc in ipairs(part:GetDescendants()) do
        if desc:IsA("ProximityPrompt") then
            table.insert(prompts, desc)
        end
    end
    if #prompts == 0 then return false, "no prompts" end

    local char = player and player.Character
    local hrp = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso"))
    for _,prompt in ipairs(prompts) do
        if distanceEnabled and hrp then
            local pos = getWorldPositionFromInstance(prompt)
            if pos then
                local dist = (hrp.Position - pos).Magnitude
                if dist > maxDist then
                    -- skip this prompt due to distance
                    return false, "skipped_by_distance"
                end
            end
        end
        local okBegin, errBegin = pcall(function() prompt:InputHoldBegin() end)
        if okBegin then
            task.wait(holdDuration)
            pcall(function() prompt:InputHoldEnd() end)
        else
            -- try InputHoldEnd anyway after tiny wait
            task.wait(holdDuration)
            pcall(function() prompt:InputHoldEnd() end)
        end
    end
    return true, "triggered_prompts"
end

-- trigger generic prompt instance (when scanning all prompts)
local function triggerPromptInstance(prompt, holdDuration, distanceEnabled, maxDist)
    if not prompt or not prompt:IsA("ProximityPrompt") then return false, "invalid" end
    local char = player and player.Character
    local hrp = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso"))
    if distanceEnabled and hrp then
        local pos = getWorldPositionFromInstance(prompt)
        if pos then
            local dist = (hrp.Position - pos).Magnitude
            if dist > maxDist then
                return false, "skipped_by_distance"
            end
        end
    end
    local okBegin = false
    pcall(function() prompt:InputHoldBegin(); okBegin = true end)
    if okBegin then
        task.wait(holdDuration)
        pcall(function() prompt:InputHoldEnd() end)
        return true, "triggered"
    else
        -- fallback: try InputHoldEnd after wait
        task.wait(holdDuration)
        pcall(function() prompt:InputHoldEnd() end)
        return false, "failed_begin"
    end
end


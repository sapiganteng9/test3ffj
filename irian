-- ===============================================
-- FUNGSI UTILITY
-- ===============================================

local function getTerrainSize()
    local terrain = workspace.Terrain
    local size = terrain.Size
    return size
end

local function findPartPosition(part)
    -- Cari posisi di atas tanah (Y paling bawah dari part)
    if part then
        local partPosition = part.Position
        local partSize = part.Size
        local positionAboveGround = partPosition + Vector3.new(0, partSize.Y / 2 + 3, 0)
        return positionAboveGround
    end
    return nil
end

local function teleportCharacterToPosition(targetPosition)
    if not character or not humanoidRootPart then return end
    
    -- Disable noclip sementara untuk teleport yang aman
    local oldNoclip = Config.noclipEnabled
    Config.noclipEnabled = false
    
    -- Tunggu sebentar agar noclip off
    wait(0.1)
    
    -- Teleport
    humanoidRootPart.CFrame = CFrame.new(targetPosition + Vector3.new(0, 3, 0))
    
    wait(0.1)
    
    -- Restore noclip setting
    Config.noclipEnabled = oldNoclip
end

local function findAllTargets()
    -- Cari semua Batu di BatuBesar
    local batubesarFolder = workspace.Workspace:FindFirstChild("BahanCraft")
    if batubesarFolder then
        local batubesarGroup = batubesarFolder:FindFirstChild("BatuBesar")
        if batubesarGroup then
            for _, batuFolder in pairs(batubesarGroup:GetChildren()) do
                if batuFolder.Name == "Batu" and batuFolder:IsA("Folder") or batuFolder:IsA("Model") then
                    for _, part in pairs(batuFolder:GetDescendants()) do
                        if part:IsA("BasePart") and part.Name == "Batu" then
                            table.insert(Targets.batu, part)
                        end
                    end
                end
            end
        end
        
        -- Cari semua Batang di PohonBesar
        local pohonbesarGroup = batubesarFolder:FindFirstChild("PohonBesar")
        if pohonbesarGroup then
            for _, batangFolder in pairs(pohonbesarGroup:GetChildren()) do
                if batangFolder.Name == "Batang" and batangFolder:IsA("Folder") or batangFolder:IsA("Model") then
                    for _, part in pairs(batangFolder:GetDescendants()) do
                        if part:IsA("BasePart") and part.Name == "Batang" then
                            table.insert(Targets.batang, part)
                        end
                    end
                end
            end
        end
    end
end

local function applyNoclip()
    if Config.noclipEnabled and character then
        for _, part in pairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end
end

local function removeNoclip()
    if character then
        for _, part in pairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = true
            end
        end
    end
end


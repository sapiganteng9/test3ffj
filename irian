-- ===============================================
-- MAIN TELEPORT LOOP
-- ===============================================

local function performTeleport()
    local allTargets = {}
    
    -- Kumpulkan target yang dipilih
    if Config.selectedTargets.batu then
        for _, part in pairs(Targets.batu) do
            if part and part.Parent then
                table.insert(allTargets, part)
            end
        end
    end
    
    if Config.selectedTargets.batang then
        for _, part in pairs(Targets.batang) do
            if part and part.Parent then
                table.insert(allTargets, part)
            end
        end
    end
    
    if #allTargets == 0 then return end
    
    -- Teleport ke setiap target
    for _, targetPart in pairs(allTargets) do
        if Config.teleportEnabled and targetPart and targetPart.Parent then
            local targetPos = findPartPosition(targetPart)
            if targetPos then
                teleportCharacterToPosition(targetPos)
                
                -- Auto Hold E
                if Config.autoHoldEEnabled then
                    local mouse = player:GetMouse()
                    local UIS = UserInputService
                    
                    -- Simulate E press
                    UIS:SendKeyEvent(true, Enum.KeyCode.E, false, game)
                    wait(0.5)
                    UIS:SendKeyEvent(false, Enum.KeyCode.E, false, game)
                end
                
                -- Tunggu sesuai delay
                wait(Config.teleportDelay)
            end
        end
    end
end


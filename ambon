-- ============================================
-- FUNCTIONS: TELEPORT
-- ============================================

local function GetAllResources()
    local bahanCraft = Workspace:FindFirstChild("BahanCraft")
    local resources = {}
    
    if not bahanCraft then
        print("[TELEPORT] BahanCraft not found!")
        return resources
    end
    
    for _, child in ipairs(bahanCraft:GetChildren()) do
        if child:IsA("Model") then
            local hrp = child:FindFirstChild("HumanoidRootPart")
            if hrp then
                resources[child.Name] = {
                    model = child,
                    position = hrp.Position,
                    hrp = hrp
                }
                print("[TELEPORT] Found resource:", child.Name, "at", hrp.Position)
            end
        end
    end
    
    return resources
end

local function TeleportToResource(resourceData)
    if not Character or not Character:FindFirstChild("HumanoidRootPart") then
        print("[TELEPORT] Character not found!")
        return false
    end
    
    if not resourceData or not resourceData.hrp then
        print("[TELEPORT] Resource invalid!")
        return false
    end
    
    -- Teleport dengan offset random
    local offsetX = math.random(-10, 10)
    local offsetZ = math.random(-10, 10)
    local targetPos = resourceData.hrp.Position + Vector3.new(offsetX, 3, offsetZ)
    
    print("[TELEPORT] Teleporting to:", resourceData.model.Name, "at", targetPos)
    
    Character:MoveTo(targetPos)
    return true
end

local function AutoTeleport()
    if TeleportLoopActive then
        print("[TELEPORT] Loop already active!")
        return
    end
    
    TeleportLoopActive = true
    print("[TELEPORT] Starting teleport loop...")
    
    while Config.TeleportEnabled and TeleportLoopActive do
        local resources = GetAllResources()
        
        -- Teleport ke Batu Besar jika dipilih
        if Config.SelectedLocations.BatuBesar and resources.BatuBesar then
            print("[TELEPORT] >> Going to BatuBesar")
            TeleportToResource(resources.BatuBesar)
            task.wait(Config.TeleportDelay)
        end
        
        -- Teleport ke Pohon Besar jika dipilih
        if Config.SelectedLocations.PohonBesar and resources.PohonBesar then
            print("[TELEPORT] >> Going to PohonBesar")
            TeleportToResource(resources.PohonBesar)
            task.wait(Config.TeleportDelay)
        end
        
        task.wait(0.5)
    end
    
    TeleportLoopActive = false
    print("[TELEPORT] Loop stopped")
end

-- ============================================
-- FUNCTIONS: AUTO SWING
-- ============================================

local function GetNearbyResources()
    local resources = GetAllResources()
    local nearbyResources = {}
    
    if not Character or not Character:FindFirstChild("HumanoidRootPart") then
        return nearbyResources
    end
    
    local playerPos = Character.HumanoidRootPart.Position
    
    for resourceName, resourceData in pairs(resources) do
        local distance = (playerPos - resourceData.position).Magnitude
        
        if resourceName == "PohonBesar" and distance <= Config.ProximityDistance.PohonBesar then
            table.insert(nearbyResources, {
                name = "PohonBesar",
                distance = distance,
                data = resourceData
            })
            print("[PROXIMITY] Pohon detected at distance:", distance)
        elseif resourceName == "BatuBesar" and distance <= Config.ProximityDistance.BatuBesar then
            table.insert(nearbyResources, {
                name = "BatuBesar",
                distance = distance,
                data = resourceData
            })
            print("[PROXIMITY] Batu detected at distance:", distance)
        end
    end
    
    return nearbyResources
end

local function GetEquippedTool()
    if not Character then return nil end
    
    for _, item in ipairs(Character:GetChildren()) do
        if item:IsA("Tool") then
            print("[TOOL] Found tool:", item.Name)
            return item
        end
    end
    
    return nil
end

local function ActivateToolSwing(tool)
    if not tool then
        print("[SWING] No tool equipped!")
        return false
    end
    
    -- Method 1: Activate signal
    if tool:FindFirstChild("Handle") then
        print("[SWING] Swinging tool:", tool.Name)
        
        -- Try firing Activated signal
        if tool:IsA("Tool") then
            tool:Activate()
            return true
        end
    end
    
    return false
end

local function AutoSwing()
    if SwingLoopActive then
        print("[SWING] Loop already active!")
        return
    end
    
    SwingLoopActive = true
    print("[SWING] Starting swing loop...")
    
    while Config.SwingEnabled and SwingLoopActive do
        local nearbyResources = GetNearbyResources()
        
        if #nearbyResources > 0 then
            local tool = GetEquippedTool()
            
            if tool then
                print("[SWING] Swinging at", #nearbyResources, "resources")
                ActivateToolSwing(tool)
                task.wait(Config.HoldDuration)
            else
                print("[SWING] No tool equipped, waiting...")
                task.wait(1)
            end
        else
            task.wait(0.5)
        end
    end
    
    SwingLoopActive = false
    print("[SWING] Loop stopped")
end


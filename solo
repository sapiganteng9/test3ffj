-- logging helper that updates debug label and prints
local function guiLog(...)
    local parts = {}
    for i=1, select("#", ...) do parts[#parts+1] = tostring(select(i, ...)) end
    local line = table.concat(parts, " ")
    pcall(function()
        if ui and ui.Debug and ui.Debug:IsA("TextLabel") then
            ui.Debug.Text = (ui.Debug.Text or "") .. "\n" .. line
            -- keep last N lines
            local lines = {}
            for l in string.gmatch(ui.Debug.Text, "[^\n]+") do table.insert(lines, l) end
            if #lines > 12 then ui.Debug.Text = table.concat({unpack(lines, #lines-11, #lines)}, "\n") end
        end
    end)
    safePrint(line)
end

local running = false
local stopRequested = false
local loopCount = 0

ui.Start.MouseButton1Click:Connect(function()
    if running then guiLog("Already running"); return end
    running = true; stopRequested = false
    ui.Status.Text = "Running..."
    guiLog("Loop started")
    spawn(function()
        local delaySec = tonumber(ui.DelayBox.Text) or 2.0
        while running and not stopRequested do
            ui.Status.Text = "Cycle running..."
            local ok = pcall(function() return singleCycle(guiLog) end)
            loopCount = loopCount + 1
            ui.Counter.Text = "Cycles completed: "..tostring(loopCount)
            ui.Status.Text = "Cycle done. Waiting "..tostring(delaySec).."s"
            local waitStart = tick()
            while tick()-waitStart < delaySec do
                if stopRequested then break end
                wait(0.1)
            end
        end
        running = false; stopRequested = false
        ui.Status.Text = "Stopped"
        guiLog("Loop stopped")
    end)
end)

ui.Stop.MouseButton1Click:Connect(function()
    if not running then guiLog("Not running") return end
    stopRequested = true

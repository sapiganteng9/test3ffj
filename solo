-- ------------- Utilities -------------
local function safePrint(...)
    local parts = {}
    for i=1, select("#", ...) do parts[#parts+1] = tostring(select(i, ...)) end
    local s = table.concat(parts, " ")
    pcall(print, "[TruckAutoLoop]", s)
end

local function safeNew(class, props)
    local ok, inst = pcall(function() return Instance.new(class) end)
    if not ok or not inst then
        safePrint("Failed to create instance:", class)
        return nil
    end
    if props then
        for k,v in pairs(props) do
            pcall(function()
                if k == "Parent" then inst.Parent = v else inst[k] = v end
            end)
        end
    end
    return inst
end

local function tryCallFunction(f, ...)
    if type(f) ~= "function" then return false, "not a function" end
    local ok, res = pcall(f, ...)
    return ok, res
end

-- Parent ScreenGui robustly (tries PlayerGui, CoreGui, gethui, get_hidden_gui, syn.protect_gui)
local function safeParentScreenGui(screen)
    if not screen or not screen:IsA("ScreenGui") then return false, "invalid screen" end
    local tried = {}

    -- try PlayerGui
    local lp = Players.LocalPlayer
    if lp then
        local pg = lp:FindFirstChild("PlayerGui") or (lp:WaitForChild and pcall(function() return lp:WaitForChild("PlayerGui", 0.1) end) and lp.PlayerGui)
        if pg then
            pcall(function() screen.Parent = pg end)
            if screen.Parent == pg then return true, "PlayerGui" end
            tried[#tried+1] = "PlayerGui failed"
        else
            tried[#tried+1] = "PlayerGui missing"
        end
    else
        tried[#tried+1] = "Players.LocalPlayer nil"
    end

    -- try CoreGui
    local ok, cg = pcall(function() return game:GetService("CoreGui") end)
    if ok and cg then
        pcall(function() screen.Parent = cg end)
        if screen.Parent == cg then
            -- protect if syn available
            if type(syn) == "table" and type(syn.protect_gui) == "function" then
                pcall(function() syn.protect_gui(screen) end)
            end
            return true, "CoreGui"
        end
        tried[#tried+1] = "CoreGui parent failed"
    else
        tried[#tried+1] = "CoreGui not accessible"
    end

    -- try gethui/get_hidden_gui (exploit APIs)
    if type(gethui) == "function" then
        local ok2, g = pcall(gethui)
        if ok2 and g then
            pcall(function() screen.Parent = g end)
            if screen.Parent == g then return true, "gethui" end
            tried[#tried+1] = "gethui returned but parent failed"
        else
            tried[#tried+1] = "gethui call failed"
        end
    end
    if type(get_hidden_gui) == "function" then
        local ok3, g2 = pcall(get_hidden_gui)
        if ok3 and g2 then
            pcall(function() screen.Parent = g2 end)
            if screen.Parent == g2 then return true, "get_hidden_gui" end
            tried[#tried+1] = "get_hidden_gui returned but parent failed"
        else
            tried[#tried+1] = "get_hidden_gui failed"
        end
    end

    -- final fallback: attempt CoreGui again
    pcall(function() screen.Parent = CoreGui end)
    if screen.Parent == CoreGui then
        if type(syn) == "table" and type(syn.protect_gui) == "function" then
            pcall(function() syn.protect_gui(screen) end)
        end
        return true, "CoreGui-final"
    end

    return false, table.concat(tried, "; ")
end

-- ------------- Debug / Notification -------------
local function playSoundId(id, vol)
    if not id then return end
    pcall(function()
        local s = Instance.new("Sound")
        s.SoundId = tostring(id)
        s.Volume = vol or 1
        s.Parent = SoundService
        s:Play()
        s.Ended:Connect(function() pcall(function() s:Destroy() end) end)
        delay(6, function() if s and s.Parent then pcall(function() s:Destroy() end) end)
    end)
end

-- ------------- Remote discovery & wrappers -------------
local function refreshRemotes()
    local spawnRemote = nil
    if ReplicatedStorage:FindFirstChild("TruckSpawnerRemotes") then
        spawnRemote = ReplicatedStorage.TruckSpawnerRemotes:FindFirstChild("SpawnTruck")
    end
    if not spawnRemote then
        for _,c in ipairs(ReplicatedStorage:GetDescendants()) do
            if (c:IsA("RemoteEvent") or c:IsA("RemoteFunction")) and string.find(string.lower(c.Name), "spawn") then spawnRemote = c; break end
        end
    end

    local findNearest = ReplicatedStorage:FindFirstChild("FindNearestCargo") or (function()
        for _,c in ipairs(ReplicatedStorage:GetDescendants()) do
            if (c:IsA("RemoteFunction") or c:IsA("RemoteEvent")) and string.find(string.lower(c.Name), "findnearest") then return c end
        end
        return nil
    end)()

    local cargoNotify = ReplicatedStorage:FindFirstChild("CargoFullNotify")
    local notifyClient = ReplicatedStorage:FindFirstChild("NotifyClient")
    return spawnRemote, findNearest, cargoNotify, notifyClient
end

local function findDeliverRemote()
    local keywords = {"deliver","dropoff","complete","finish","claim","drop","finishdelivery","completedelivery"}
    for _, c in ipairs(ReplicatedStorage:GetDescendants()) do
        if (c:IsA("RemoteEvent") or c:IsA("RemoteFunction")) then
            local n = string.lower(c.Name)
            for _,kw in ipairs(keywords) do if string.find(n, kw) then return c end end
        end
    end
    return nil
end

local function safeFire(ev, ...)
    if not ev then return false, "not found" end
    if typeof(ev.FireServer) == "function" then
        local ok, err = pcall(function() ev:FireServer(...) end)
        return ok, err
    end
    return false, "not RemoteEvent"
end

local function safeInvoke(fn, ...)
    if not fn then return false, "not found" end
    if typeof(fn.InvokeServer) == "function" then
        local ok, res = pcall(function() return fn:InvokeServer(...) end)
        if ok then return true, res else return false, res end
    elseif typeof(fn.FireServer) == "function" then
        local ok, res = pcall(function() fn:FireServer(...) end)
        return ok, res
    end
    return false, "not callable"
end

-- ------------- Helpers: find destination & truck -------------
local function findDescendantByName(root, name)
    for _, child in ipairs(root:GetChildren()) do
        if child.Name == name then return child end
        local found = findDescendantByName(child, name)
        if found then return found end
    end
    return nil
end

local function getDestinationPart()
    local targetName = "DestinationPoint_PakanTernak"
    local inst = Workspace:FindFirstChild(targetName) or findDescendantByName(Workspace, targetName)
    if not inst then
        for _, c in ipairs(Workspace:GetDescendants()) do
            if string.lower(c.Name) == string.lower(targetName) then inst = c; break end
        end
    end
    if not inst then return nil end
    if inst:IsA("Model") then
        if inst.PrimaryPart then return inst.PrimaryPart end
        for _, d in ipairs(inst:GetDescendants()) do if d:IsA("BasePart") then return d end end
        return nil
    end
    if inst:IsA("BasePart") then return inst end
    return nil
end

local function isLikelyTruckModel(m)
    if not m or not m:IsA("Model") then return false end
    local n = string.lower(m.Name or "")
    if string.find(n, "truck") or string.find(n, "truk") or string.find(n, "besi") then return true end
    for _, d in ipairs(m:GetDescendants()) do
        if d:IsA("VehicleSeat") or d:IsA("Seat") then return true end
    end
    return false
end

local function waitForSpawnedTruck(timeout)
    timeout = timeout or 8
    local start = tick()
    for _, m in ipairs(Workspace:GetChildren()) do if isLikelyTruckModel(m) then return m end end
    local found
    local conn = Workspace.DescendantAdded:Connect(function(obj)
        if found then return end
        if obj:IsA("Model") and isLikelyTruckModel(obj) then found = obj end
        local pm = obj:FindFirstAncestorOfClass("Model")
        if pm and isLikelyTruckModel(pm) then found = pm end
    end)
    while tick() - start < timeout and not found do wait(0.1) end
    if conn then conn:Disconnect() end
    return found
end

local function trySeatInVehicle(truckModel)
    if not truckModel then return false, "no truck"
    end
    local seat
    for _, d in ipairs(truckModel:GetDescendants()) do
        if d:IsA("VehicleSeat") or d:IsA("Seat") then seat = d; break end
    end
    if not seat then return false, "no seat"
    end
    local char = Players.LocalPlayer and Players.LocalPlayer.Character
    if not char then return false, "no char" end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not humanoid or not hrp then return false, "no humanoid/hrp" end
    pcall(function() hrp.CFrame = seat.CFrame * CFrame.new(0,2,0) end)
    pcall(function() humanoid.Sit = true end)
    local t0 = tick()
    while tick() - t0 < 2 do
        if seat.Occupant and seat.Occupant.Parent == humanoid then return true, "seated" end
        if humanoid.SeatPart == seat then return true, "seated" end
        wait(0.12)
    end
    return false, "seat not confirmed"
end

-- ------------- Single cycle (spawn->load->seat->deliver) -------------
local function singleCycle(logToGui)
    local spawnRemote, findNearest, cargoNotify, notifyClient = refreshRemotes()
    if logToGui then logToGui("Remotes: spawn="..tostring(spawnRemote)..", findNearest="..tostring(findNearest)..", cargoNotify="..tostring(cargoNotify)) end

    -- spawn
    if spawnRemote then
        local ok, err = safeFire(spawnRemote, "BESI TUA")
        if logToGui then logToGui("Spawn fired: "..tostring(ok).." "..tostring(err)) end
    else
        if logToGui then logToGui("Spawn remote not found") end
    end

    local truck = waitForSpawnedTruck(8)
    if logToGui then logToGui("Truck found: "..tostring(truck)) end
    wait(0.8)

    -- load x2
    if findNearest then
        local ok1,r1 = safeInvoke(findNearest, "Pupuk")
        wait(0.45)
        local ok2,r2 = safeInvoke(findNearest, "Pupuk")
        if logToGui then logToGui("Load results: "..tostring(ok1)..","..tostring(ok2)) end
    else
        if logToGui then logToGui("FindNearestCargo missing") end
    end
    wait(0.6)

    -- seat
    local seatOk, seatMsg = trySeatInVehicle(truck)
    if logToGui then logToGui("Seat attempt: "..tostring(seatOk).." "..tostring(seatMsg)) end
    wait(0.6)

    -- deliver
    local dest = getDestinationPart()
    if not dest then
        if logToGui then logToGui("Destination missing -> simulate success") end
        if logToGui then
            logToGui("SIMULATED: PENGIRIMAN BERHASIL (client-only)")
            pcall(function() playSoundId("rbxassetid://5314631765", 1) end)
        end
        return true
    end

    local delivered = false
    if cargoNotify then
        local ok, err = safeFire(cargoNotify, dest.Position)
        if ok then delivered = true end
        if logToGui then logToGui("CargoFullNotify call: "..tostring(ok).." "..tostring(err)) end
    end

    if not delivered then
        local dr = findDeliverRemote()
        if dr then
            if dr:IsA("RemoteFunction") then
                local ok,res = safeInvoke(dr, "Pupuk", dest)
                if ok then delivered = true end
                if logToGui then logToGui("Deliver invoke: "..tostring(ok).." "..tostring(res)) end
            else
                local ok,res = safeFire(dr, "Pupuk", dest)
                if ok then delivered = true end
                if logToGui then logToGui("Deliver fire: "..tostring(ok).." "..tostring(res)) end
            end
        end
    end

    if not delivered then
        -- fallback teleport player to destination (client-only)
        local char = Players.LocalPlayer and Players.LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp and dest and dest:IsA("BasePart") then
            pcall(function() hrp.CFrame = dest.CFrame * CFrame.new(0,3,0) end)
            if logToGui then logToGui("Teleported to dest (simulated success)") end
            pcall(function() playSoundId("rbxassetid://5314631765", 1) end)
            delivered = true
        else
            if logToGui then logToGui("Fallback deliver failed (no hrp/dest)") end
        end
    end

    return delivered
end


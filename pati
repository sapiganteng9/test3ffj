-- Minimal implementations of actions (spawn -> load -> seat -> deliver)
local function safeRefreshRemotes()
    local spawnRemote = nil
    pcall(function()
        if ReplicatedStorage:FindFirstChild("TruckSpawnerRemotes") then
            spawnRemote = ReplicatedStorage.TruckSpawnerRemotes:FindFirstChild("SpawnTruck")
        end
        if not spawnRemote then
            for _, c in ipairs(ReplicatedStorage:GetDescendants()) do
                if (c:IsA("RemoteEvent") or c:IsA("RemoteFunction")) and string.find(string.lower(c.Name), "spawn") then spawnRemote = c break end
            end
        end
    end)
    local findNearest = ReplicatedStorage:FindFirstChild("FindNearestCargo")
    local cargoNotify = ReplicatedStorage:FindFirstChild("CargoFullNotify")
    local notifyClient = ReplicatedStorage:FindFirstChild("NotifyClient")
    return spawnRemote, findNearest, cargoNotify, notifyClient
end

local function tryFire(ev, ...)
    if not ev then return false, "not found" end
    if typeof(ev.FireServer) == "function" then
        return pcall(function() ev:FireServer(...) end)
    end
    return false, "not a RemoteEvent"
end

local function tryInvoke(fn, ...)
    if not fn then return false, "not found" end
    if typeof(fn.InvokeServer) == "function" then
        return pcall(function() return fn:InvokeServer(...) end)
    elseif typeof(fn.FireServer) == "function" then
        return pcall(function() fn:FireServer(...) end)
    end
    return false, "not callable"
end

local function findDestination()
    local name = "DestinationPoint_PakanTernak"
    local found = Workspace:FindFirstChild(name) or nil
    if not found then
        for _, d in ipairs(Workspace:GetDescendants()) do
            if string.lower(d.Name) == string.lower(name) then found = d; break end
        end
    end
    if found and found:IsA("Model") then
        if found.PrimaryPart then return found.PrimaryPart end
        for _,c in ipairs(found:GetDescendants()) do if c:IsA("BasePart") then return c end end
        return nil
    end
    if found and found:IsA("BasePart") then return found end
    return nil
end

local function simpleWaitForTruck(timeout)
    timeout = timeout or 8
    local start = tick()
    while tick()-start < timeout do
        for _, m in ipairs(Workspace:GetChildren()) do
            if m:IsA("Model") and (string.find(string.lower(m.Name or ""), "truck") or m:FindFirstChildOfClass("VehicleSeat")) then
                return m
            end
        end
        wait(0.25)
    end
    return nil
end

local function attemptSeat(truckModel)
    if not pl or not pl.Character then return false, "no char" end
    local humanoid = pl.Character:FindFirstChildOfClass("Humanoid")
    local hrp = pl.Character:FindFirstChild("HumanoidRootPart")
    if not humanoid or not hrp then return false, "no humanoid/hrp" end
    local seat = nil
    if truckModel then
        for _,d in ipairs(truckModel:GetDescendants()) do
            if d:IsA("VehicleSeat") or d:IsA("Seat") then seat = d; break end
        end
    end
    if not seat then return false, "no seat found" end
    pcall(function() hrp.CFrame = seat.CFrame * CFrame.new(0,2,0) end)
    pcall(function() humanoid.Sit = true end)
    local t0 = tick()
    while tick()-t0 < 2 do
        if seat.Occupant and seat.Occupant.Parent == humanoid then return true, "seated" end
        if humanoid.SeatPart == seat then return true, "seated" end
        wait(0.1)
    end
    return false, "seat check timeout"
end

-- single automated sequence (safe)
local function singleSequence()
    local spawnRemote, findNearest, cargoNotify, notifyClient = safeRefreshRemotes()
    log("Remotes:", tostring(spawnRemote), tostring(findNearest), tostring(cargoNotify))
    -- spawn truck
    if spawnRemote then
        local ok, err = tryFire(spawnRemote, "BESI TUA")
        log("Spawn request fired:", ok, err)
    else
        log("Spawn remote not found; skipping spawn.")
    end
    local truck = simpleWaitForTruck(8)
    log("Truck found:", tostring(truck))
    wait(0.8)
    -- load pupuk twice
    if findNearest then
        local ok1, r1 = tryInvoke(findNearest, "Pupuk")
        wait(0.45)
        local ok2, r2 = tryInvoke(findNearest, "Pupuk")
        log("FindNearestCargo calls:", ok1, ok2, tostring(r1), tostring(r2))
    else
        log("FindNearestCargo remote missing")
    end
    wait(0.6)
    -- try seat
    local seatOk, seatMsg = attemptSeat(truck)
    log("Seat attempt:", seatOk, seatMsg)
    wait(0.6)
    -- deliver to destination
    local dest = findDestination()
    if not dest then
        log("Destination not found; simulating success.")
        notify({Title="PENGIRIMAN BERHASIL", Message="(simulated)", AccentColor = Color3.new(0.392,1,0.588), Duration = 3.5, Sound = "rbxassetid://5314631765"})
        return true
    end
    -- try CargoFullNotify
    if cargoNotify then
        local ok, err = tryFire(cargoNotify, dest.Position)
        log("CargoFullNotify fired:", ok, err)
        if ok then return true end
    end
    -- try find deliver remote heuristically
    local foundDeliver = nil
    for _, c in ipairs(ReplicatedStorage:GetDescendants()) do
        if (c:IsA("RemoteEvent") or c:IsA("RemoteFunction")) and string.find(string.lower(c.Name), "deliver") then foundDeliver = c; break end
    end
    if foundDeliver then
        if foundDeliver:IsA("RemoteFunction") then
            local ok, res = tryInvoke(foundDeliver, "Pupuk", dest)
            log("DeliverInvoke:", ok, tostring(res))
            if ok then return true end
        else
            local ok, res = tryFire(foundDeliver, "Pupuk", dest)
            log("DeliverFire:", ok, tostring(res))
            if ok then return true end
        end
    end
    -- final fallback teleport + simulate
    if pl and pl.Character and pl.Character:FindFirstChild("HumanoidRootPart") and dest:IsA("BasePart") then
        pcall(function() pl.Character.HumanoidRootPart.CFrame = dest.CFrame * CFrame.new(0,3,0) end)
        notify({Title="PENGIRIMAN BERHASIL", Message="(simulated teleport)", AccentColor = Color3.new(0.392,1,0.588), Duration = 3.5, Sound = "rbxassetid://5314631765"})
        return true
    end
    log("All delivery attempts failed.")
    return false
end

-- loop control variables
local running = false
local loopDelay = 2.0
local loopCount = 0
local loopThread = nil

-- connect GUI buttons
gui.Start.MouseButton1Click:Connect(function()
    if running then log("Already running") return end
    running = true
    gui.Status.Text = "Status: running"
    loopThread = coroutine.create(function()
        while running do
            local ok, err = pcall(singleSequence)
            loopCount = loopCount + 1
            log("Cycle", loopCount, "completed. result:", ok, err)
            if not ok then
                log("singleSequence error:", tostring(err))
            end
            local t0 = tick()
            while tick()-t0 < loopDelay do
                if not running then break end
                wait(0.1)
            end
        end
        gui.Status.Text = "Status: idle"
    end)
    coroutine.resume(loopThread)
end)

gui.Stop.MouseButton1Click:Connect(function()
    running = false
    gui.Status.Text = "Status: stopping..."
    log("Stop requested.")
end)

gui.RunOnce.MouseButton1Click:Connect(function()
    gui.Status.Text = "Status: running one cycle..."
    local ok, err = pcall(singleSequence)
    log("RunOnce result:", ok, err)
    gui.Status.Text = "Status: idle"
end)

gui.Close.MouseButton1Click:Connect(function()
    pcall(function() if gui.Screen then gui.Screen:Destroy() end end)
end)


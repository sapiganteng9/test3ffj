    safeNew("UICorner", {Parent = startBtn, CornerRadius = UDim.new(0,6)})
    safeNew("UICorner", {Parent = stopBtn, CornerRadius = UDim.new(0,6)})
    safeNew("UICorner", {Parent = runOnceBtn, CornerRadius = UDim.new(0,6)})

    -- debug label reference
    _G.__AutoLoopStatusLabel = status

    -- make draggable (basic)
    local dragging = false
    local dragStart, startPos
    frame.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = inp.Position
            startPos = frame.Position
            inp.Changed:Connect(function()
                if inp.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    frame.InputChanged:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseMovement then dragInput = inp end
    end)
    UserInputService.InputChanged:Connect(function(inp)
        if dragging and inp.UserInputType == Enum.UserInputType.MouseMovement then

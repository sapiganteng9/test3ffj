-- Small safe helper to create instances (pcall-protected)
local function safeNew(class, props)
    local ok, inst = pcall(function() return Instance.new(class) end)
    if not ok or not inst then
        log("ERROR: cannot create instance of", class)
        return nil
    end
    if props then
        for k,v in pairs(props) do
            pcall(function()
                if k == "Parent" then inst.Parent = v else inst[k] = v end
            end)
        end
    end
    return inst
end


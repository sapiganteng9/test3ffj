-- Simple logger that both prints and writes to on-screen debug panel
local function log(...)
    local s = ""
    for i=1,select("#", ...) do
        s = s .. tostring(select(i, ...))
        if i < select("#", ...) then s = s .. "\t" end
    end
    pcall(function() print("[AutoLoop]", s) end)
    -- append to debug label
    if _G.__AutoLoopDebugLabel and _G.__AutoLoopDebugLabel.Parent then
        local lbl = _G.__AutoLoopDebugLabel
        lbl.Text = (lbl.Text == "" and "" or lbl.Text .. "\n") .. s
        -- keep it short
        local lines = {}
        for line in string.gmatch(lbl.Text, "[^\n]+") do table.insert(lines, line) end
        if #lines > 20 then
            local newtxt = table.concat({unpack(lines, #lines-19, #lines)}, "\n")
            lbl.Text = newtxt
        end
    end
end


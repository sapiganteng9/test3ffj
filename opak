local function findAllTargets()
    Targets.batu = {}
    Targets.batang = {}
    
    local function searchForParts(instance, partName, targetTable)
        if instance:IsA("BasePart") and instance.Name == partName then
            table.insert(targetTable, instance)
        end
        
        for _, child in pairs(instance:GetChildren()) do
            searchForParts(child, partName, targetTable)
        end
    end
    
    searchForParts(workspace, "Batu", Targets.batu)
    searchForParts(workspace, "Batang", Targets.batang)
    
    print("✓ Batu ditemukan: " .. #Targets.batu)
    print("✓ Batang ditemukan: " .. #Targets.batang)
end

local function findPartPosition(part)
    if part and part.Parent then
        local partPosition = part.Position
        local partSize = part.Size
        
        local bottomY = partPosition.Y - (partSize.Y / 2)
        
        local positionAboveGround = Vector3.new(
            partPosition.X,
            bottomY + 3,
            partPosition.Z
        )
        
        return positionAboveGround
    end
    return nil
end

local function teleportCharacterToPosition(targetPosition)
    if not character or not humanoidRootPart or not humanoidRootPart.Parent then return false end
    
    local success = pcall(function()
        local oldNoclip = Config.noclipEnabled
        
        for _, part in pairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                pcall(function()
                    part.CanCollide = false
                end)
            end
        end
        
        humanoidRootPart.CFrame = CFrame.new(targetPosition)
        
        wait(0.2)
        
        if not oldNoclip then
            for _, part in pairs(character:GetDescendants()) do
                if part:IsA("BasePart") then
                    pcall(function()
                        part.CanCollide = true
                    end)
                end
            end
        end
    end)
    
    return success
end

local function applyNoclip()
    if character then
        for _, part in pairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                pcall(function()
                    part.CanCollide = false
                end)
            end
        end
    end
end

local function removeNoclip()
    if character then
        for _, part in pairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                pcall(function()
                    part.CanCollide = true
                end)
            end
        end
    end
end

-- ===============================================
-- AUTO HOLD E (MENGGUNAKAN PROXIMITY PROMPT)
-- ===============================================

local function triggerProximityPromptsOnPart(part, holdDuration)
    if not part or not part:IsA("BasePart") then return false end
    
    local prompts = {}
    for _, desc in ipairs(part:GetDescendants()) do
        if desc:IsA("ProximityPrompt") then
            table.insert(prompts, desc)
        end
    end
    
    if #prompts == 0 then return false end
    
    for _, prompt in ipairs(prompts) do
        pcall(function()
            prompt:InputHoldBegin()
            wait(holdDuration)
            prompt:InputHoldEnd()
        end)
    end
    
    return true
end

-- ===============================================
-- FLY SYSTEM
-- ===============================================

local function startFly()
    if not character or not humanoidRootPart then return end
    
    flying = true
    
    bodyVelocity = Instance.new("BodyVelocity")
    bodyVelocity.Velocity = Vector3.new(0, 0, 0)
    bodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bodyVelocity.Parent = humanoidRootPart
    
    bodyGyro = Instance.new("BodyGyro")
    bodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bodyGyro.CFrame = humanoidRootPart.CFrame
    bodyGyro.Parent = humanoidRootPart
    
    character.Humanoid.PlatformStand = true
    
    if flyConnection then
        flyConnection:Disconnect()
    end
    
    flyConnection = RunService.RenderStepped:Connect(function()
        if not flying or not character or not humanoidRootPart or not humanoidRootPart.Parent then
            if flyConnection then
                flyConnection:Disconnect()
            end
            return
        end
        
        local camera = workspace.CurrentCamera
        local moveDirection = Vector3.new(0, 0, 0)
        
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then
            moveDirection = moveDirection + camera.CFrame.LookVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then
            moveDirection = moveDirection - camera.CFrame.LookVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then
            moveDirection = moveDirection - camera.CFrame.RightVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then
            moveDirection = moveDirection + camera.CFrame.RightVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
            moveDirection = moveDirection + Vector3.new(0, 1, 0)
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
            moveDirection = moveDirection - Vector3.new(0, 1, 0)
        end
        
        if moveDirection.Magnitude > 0 then
            moveDirection = moveDirection.Unit
        end
        
        bodyVelocity.Velocity = moveDirection * flySpeed
        bodyGyro.CFrame = camera.CFrame
    end)
    
    print("✓ Fly AKTIF!")
end

local function stopFly()
    if flyConnection then
        flyConnection:Disconnect()
        flyConnection = nil
    end
    
    flying = false
    
    if bodyVelocity then
        bodyVelocity:Destroy()
        bodyVelocity = nil
    end
    
    if bodyGyro then
        bodyGyro:Destroy()
        bodyGyro = nil
    end
    
    if character and character.Humanoid then
        character.Humanoid.PlatformStand = false
    end
    
    print("✓ Fly NONAKTIF!")
end


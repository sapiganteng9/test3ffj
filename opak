            checkBoxBatang.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
            checkBoxBatang.TextSize = 14
            checkBoxBatang.Text = "✓"
        else
            checkBoxBatang.BackgroundColor3 = Color3.fromRGB(50, 50, 55)
            checkBoxBatang.Text = ""
        end
    end)
    
    toggleHoldE.MouseButton1Click:Connect(function()
        Config.autoHoldEEnabled = not Config.autoHoldEEnabled
        if Config.autoHoldEEnabled then
            toggleHoldE.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
            toggleHoldE.TextSize = 14
            toggleHoldE.Text = "✓"
            statusLabel.Text = "Status: Auto Hold E AKTIF\n(Gunakan ProximityPrompt)"
            statusLabel.TextColor3 = Color3.fromRGB(100, 200, 100)
        else
            toggleHoldE.BackgroundColor3 = Color3.fromRGB(50, 50, 55)
            toggleHoldE.Text = ""
            statusLabel.Text = "Status: Auto Hold E NONAKTIF"
            statusLabel.TextColor3 = Color3.fromRGB(200, 150, 100)
        end
    end)
    
    toggleNoclip.MouseButton1Click:Connect(function()
        Config.noclipEnabled = not Config.noclipEnabled
        if Config.noclipEnabled then
            toggleNoclip.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
            toggleNoclip.TextSize = 14
            toggleNoclip.Text = "✓"
            applyNoclip()
            statusLabel.Text = "Status: Noclip AKTIF"
            statusLabel.TextColor3 = Color3.fromRGB(100, 200, 100)
        else
            toggleNoclip.BackgroundColor3 = Color3.fromRGB(50, 50, 55)
            toggleNoclip.Text = ""
            removeNoclip()
            statusLabel.Text = "Status: Noclip NONAKTIF"
            statusLabel.TextColor3 = Color3.fromRGB(200, 150, 100)
        end
    end)
    
    toggleFly.MouseButton1Click:Connect(function()
        Config.flyEnabled = not Config.flyEnabled
        if Config.flyEnabled then
            toggleFly.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
            toggleFly.TextSize = 14
            toggleFly.Text = "✓"
            startFly()
            statusLabel.Text = "Status: FLY AKTIF\nGunakan WASD+Space+Ctrl"
            statusLabel.TextColor3 = Color3.fromRGB(100, 200, 100)
        else
            toggleFly.BackgroundColor3 = Color3.fromRGB(50, 50, 55)
            toggleFly.Text = ""
            stopFly()
            statusLabel.Text = "Status: FLY NONAKTIF"
            statusLabel.TextColor3 = Color3.fromRGB(200, 150, 100)
        end
    end)
    
    teleportBtn.MouseButton1Click:Connect(function()
        if not Config.selectedTargets.batu and not Config.selectedTargets.batang then
            statusLabel.Text = "Status: PILIH TARGET TERLEBIH DAHULU!"
            statusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
            return
        end
        
        Config.teleportEnabled = true
        statusLabel.Text = "Status: TELEPORT BERJALAN...\nJeda: " .. Config.teleportDelay .. " detik"
        statusLabel.TextColor3 = Color3.fromRGB(100, 200, 255)
        teleportBtn.Visible = false
        stopBtn.Visible = true
    end)
    
    stopBtn.MouseButton1Click:Connect(function()
        Config.teleportEnabled = false
        statusLabel.Text = "Status: TELEPORT DIHENTIKAN"
        statusLabel.TextColor3 = Color3.fromRGB(200, 150, 100)
        teleportBtn.Visible = true
        stopBtn.Visible = true
    end)
end

-- ===============================================
-- CHARACTER RESPAWN HANDLER
-- ===============================================

player.CharacterAdded:Connect(function(newCharacter)
    character = newCharacter
    humanoidRootPart = character:WaitForChild("HumanoidRootPart")
    
    if Config.flyEnabled then
        stopFly()
        wait(0.5)
        startFly()
    end
    
    if Config.noclipEnabled then
        wait(0.5)
        applyNoclip()
    end
end)

-- ===============================================
-- NOCLIP LOOP
-- ===============================================

spawn(function()
    while true do
        if Config.noclipEnabled and character and character.Parent then
            for _, part in pairs(character:GetDescendants()) do
                if part:IsA("BasePart") and part.Parent then
                    pcall(function()
                        part.CanCollide = false
                    end)
                end
            end
        end
        wait(0.1)
    end
end)

-- ===============================================
-- MAIN TELEPORT LOOP DENGAN AUTO HOLD E
-- MENGGUNAKAN PROXIMITY PROMPT
-- ===============================================

spawn(function()
    while true do
        if Config.teleportEnabled and character and character.Parent and humanoidRootPart and humanoidRootPart.Parent then
            local allTargets = {}
            
            if Config.selectedTargets.batu then
                for _, part in pairs(Targets.batu) do
                    if part and part.Parent then
                        table.insert(allTargets, part)
                    end
                end
            end
            
            if Config.selectedTargets.batang then
                for _, part in pairs(Targets.batang) do
                    if part and part.Parent then
                        table.insert(allTargets, part)
                    end
                end
            end
            
            if #allTargets > 0 then
                for _, targetPart in pairs(allTargets) do
                    if Config.teleportEnabled and targetPart and targetPart.Parent and humanoidRootPart and humanoidRootPart.Parent then
                        local targetPos = findPartPosition(targetPart)
                        if targetPos then
                            teleportCharacterToPosition(targetPos)
                            
                            -- Auto Hold E menggunakan ProximityPrompt
                            if Config.autoHoldEEnabled then
                                wait(0.3)
                                local success = triggerProximityPromptsOnPart(targetPart, Config.autoHoldDuration)
                                if success then
                                    print("✓ Auto Hold E triggered on: " .. targetPart.Name)
                                end
                            end
                            
                            wait(Config.teleportDelay)
                        end
                    end
                end
            else
                wait(1)
            end
        else
            wait(1)
        end
    end
end)

